      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Get Incident",
        "description": "One incident with its signals, overrides and (async) LLM explanation.",
        "operationId": "get_incident__monika_incidents__incident_id__get",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Incident Id"
