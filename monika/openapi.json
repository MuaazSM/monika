    "/_monika/reset": {
      "post": {
        "tags": [
          "reset"
        ],
        "summary": "Reset",
        "description": "Dashboard Settings \"Reset demo data\". Fast (<1s): clears incidents/sessions/transient\ndetector state but keeps learned baselines \u2014 for a full re-seed use `make reset` (CLI).",
        "operationId": "reset__monika_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
