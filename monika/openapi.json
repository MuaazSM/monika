        }
      }
    },
    "/_monika/simulate": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Simulate",
        "description": "Start one scenario as a background task; return immediately with a run id.\nRefuses to run two scenarios concurrently (409).",
        "operationId": "simulate__monika_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulateRun"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
