# Monika backend settings (CLAUDE.md §6). Copy to .env and fill in.
# .env is gitignored — never commit a real key.

MONIKA_DATABASE_URL=postgresql+asyncpg://monika:monika@postgres:5432/monika
MONIKA_REDIS_URL=redis://redis:6379/0
MONIKA_UPSTREAM_URL=http://demo-api:9000

# Must match the secret the demo API signs its tokens with.
MONIKA_JWT_SECRET=dev-insecure-secret-change-me

# Empty → explainer disabled, dashboard shows "unavailable".
MONIKA_ANTHROPIC_API_KEY=
MONIKA_ANTHROPIC_MODEL=claude-sonnet-4-6
MONIKA_EXPLAINER_ENABLED=true
# 1 → serve the cached IDOR explanation instead of calling the API (demo fallback if flaky).
MONIKA_EXPLAINER_FALLBACK=false

# 10 for demos: ladder decay in seconds instead of minutes.
MONIKA_LADDER_TIME_DIVISOR=1
MONIKA_RATE_FLOOR_RPM=20
MONIKA_ENDPOINTS_CONFIG=config/endpoints.yaml

# Must be Monika's own externally-reachable base URL — the Simulator replays scenarios
# through this proxy, not through demo-api directly. On a host with a dynamic port (e.g.
# Render's $PORT), set this to http://127.0.0.1:$PORT; localhost:8000 is only correct for
# docker-compose/local dev.
MONIKA_SELF_URL=http://localhost:8000

# Comma-separated, no trailing slash, must exactly match the dashboard's deployed origin(s)
# (scheme + host) or every dashboard request — including SSE — fails CORS silently.
MONIKA_CORS_ORIGINS=http://localhost:3000
